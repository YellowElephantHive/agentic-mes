APP_BIND_ADDR=0.0.0.0:8080
RUST_LOG=mes_api=info,tower_http=info
DATABASE_URL=postgres://agentic_mes:agentic_mes@localhost:5432/agentic_mes
TEST_DATABASE_URL=postgres://agentic_mes:agentic_mes@localhost:5432/agentic_mes
POSTGRES_DB=agentic_mes
POSTGRES_USER=agentic_mes
POSTGRES_PASSWORD=agentic_mes
# Development identity adapters must remain disabled outside local development.
APP_ENV=development
APP_RATE_LIMIT_REQUESTS_PER_MINUTE=120
AGENT_PROVIDER=mock
LLM_DATA_POLICY=local_only
AGENT_PROVIDER_TIMEOUT_MS=10000
AGENT_TOOL_TIMEOUT_MS=5000
AGENT_OVERALL_TIMEOUT_MS=45000
AGENT_PROVIDER_MAX_CONCURRENCY=4
AGENT_PROVIDER_FAILURE_THRESHOLD=3
AGENT_PROVIDER_CIRCUIT_COOLDOWN_MS=30000

# Provider selection: mock | ollama | http. External HTTP requires external_approved.
# Vendor-neutral HTTP contract:
LLM_HTTP_ENDPOINT=
LLM_HTTP_MODEL=
LLM_HTTP_API_KEY=
LLM_HTTP_TIMEOUT_MS=10000
LLM_HTTP_MAX_RETRIES=2
LLM_HTTP_RETRY_BACKOFF_MS=100
LLM_HTTP_MAX_RESPONSE_BYTES=1048576

# Native Ollama /api/chat adapter:
# Docker Desktop endpoint. For direct host `cargo run`, use 127.0.0.1 instead.
OLLAMA_ENDPOINT=http://host.docker.internal:11434/api/chat
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=60000
OLLAMA_MAX_RETRIES=2
